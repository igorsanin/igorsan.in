---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { publicProjects } from '../../lib/projects';
const all = await publicProjects();
---
<Base title="Work">
  <section class="wrap">
    <div class="head">
      <p class="eyebrow">{all.length} projects · 2016–{new Date().getFullYear()}</p>
      <h1 class="display">Work</h1>
    </div>
    <div class="grid">
      {all.map((p, i) => <Card project={p} eager={i < 6} />)}
    </div>
  </section>
</Base>
<style>
  .head { display: flex; flex-direction: column; gap: 20px; margin: clamp(24px, 4vw, 56px) 0 clamp(32px, 4vw, 48px); }
  h1 { font-size: clamp(56px, 9vw, 128px); letter-spacing: -.04em; line-height: .9; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
