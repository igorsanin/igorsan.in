---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { publicProjects } from '../../lib/projects';
const all = await publicProjects();
---
<Base title="Work">
  <section class="wrap">
    <h1 class="display">Work</h1>
    <div class="grid">
      {all.map((p, i) => <Card project={p} eager={i < 3} />)}
    </div>
  </section>
</Base>
<style>
  h1 { font-size: clamp(48px, 8vw, 120px); margin: clamp(32px, 6vw, 80px) 0 clamp(32px, 4vw, 56px); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 3vw, 44px) clamp(14px, 1.6vw, 22px); }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
