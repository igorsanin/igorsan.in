---
// Private project pages: /<vault>/<slug>. The vault prefix lives in src/data/site.json
// and is never linked from public pages, so these URLs can't be guessed. noindex.
import Base from '../../layouts/Base.astro';
import ProjectView from '../../components/ProjectView.astro';
import site from '../../data/site.json';
import { builtProjects, relatedProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const all = await builtProjects();
  const list = all.filter((p) => p.data.visibility === 'private');
  return list.map((project) => ({ params: { vault: site.vault, slug: project.id }, props: { project, related: relatedProjects(project, all) } }));
}
const { project, related } = Astro.props;
---
<Base title={project.data.title} noindex>
  <ProjectView project={project} related={related} back={false} />
</Base>
