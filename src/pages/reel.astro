---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Showreel">
  <section class="wrap reel-page">
    <p class="eyebrow">Showreel</p>
    <h1 class="display">Showreel</h1>
    <div class="frame">
      <iframe src={`https://player.vimeo.com/video/${site.reelVimeo}?dnt=1&title=0&byline=0&portrait=0&color=E5141B`} title="Showreel" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
    </div>
  </section>
</Base>
<style>
  .reel-page { padding-top: clamp(24px, 4vw, 56px); display: flex; flex-direction: column; gap: 24px; }
  h1 { font-size: clamp(48px, 7vw, 96px); letter-spacing: -.04em; line-height: .92; }
  .frame { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #000; }
  .frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
