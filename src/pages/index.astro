---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import site from '../data/site.json';
import { featuredProjects } from '../lib/projects';
import { nbsp } from '../lib/typo';
const selected = (await featuredProjects()).slice(0, 9);
const poster = selected[0]?.data.cover ?? '';
---
<Base>
  <section class="hero">
    <div class="reel" aria-hidden="true">
      {poster && <img src={poster} alt="" />}
      {site.reelVimeo && <iframe src={`https://player.vimeo.com/video/${site.reelVimeo}?background=1&dnt=1`} title="Showreel background" allow="autoplay" tabindex="-1" onload="setTimeout(()=>this.classList.add('on'),900)"></iframe>}
    </div>
    <div class="pane glass">
      <div class="wrap-in">
        <h1 class="display">{nbsp(site.heroLine)}</h1>
        <p class="sub">{nbsp(site.heroSub)}</p>
        <div class="actions">
          {site.reelVimeo && (
            <a class="pill pill-light" href="/reel/" data-reel>
              <svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1 L11 7 L1 13 Z" fill="currentColor"></path></svg>
              Watch reel
            </a>
          )}
          <a class="more" href="/about/">More about me</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="sel">
    <div class="block-head">
      <h2 id="sel" class="display">Selected work</h2>
      <a class="mono-link" href="/work/">All projects →</a>
    </div>
    <div class="grid">
      {selected.map((p, i) => <Card project={p} eager={i < 3} />)}
    </div>
  </section>

  {site.clients.length > 0 && (
    <section class="wrap block brands" aria-labelledby="brands">
      <h2 id="brands" class="display">Brands I've worked on</h2>
      <ul>{site.clients.map((c) => <li>{c}</li>)}</ul>
    </section>
  )}
</Base>

<style>
  .hero { position: relative; height: min(88vh, 920px); min-height: 560px; margin-top: -108px; overflow: hidden; }
  .reel, .reel img, .reel iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  /* background reel: an exact 16:9 box that always covers the hero (sized from the hero itself,
     not the viewport), centred and cropped left/right on tall screens, top/bottom on wide ones */
  .reel { container-type: size; }
  .reel iframe {
    width: 177.78vh; height: 56.25vw; min-width: 100%; min-height: 100%; max-width: none;
    left: 50%; top: 50%; right: auto; bottom: auto; transform: translate(-50%, -50%);
    opacity: 0; transition: opacity 1.2s ease;
  }
  @supports (width: 1cqh) {
    .reel iframe { width: max(100cqw, 177.78cqh); height: max(100cqh, 56.25cqw); min-width: 0; min-height: 0; max-width: none; }
  }
  .reel iframe.on { opacity: 1; }
  .hero::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 180px; z-index: 2; pointer-events: none; background: linear-gradient(rgba(12,12,13,.6), rgba(12,12,13,0)); }
  .pane { position: absolute; inset: 0 37% 0 0; display: flex; align-items: center; }
  .wrap-in {
    display: flex; flex-direction: column; gap: 26px;
    padding: 108px var(--gutter) 24px max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    max-width: 100%;
  }
  h1 { font-size: clamp(48px, 7vw, 104px); line-height: .93; letter-spacing: -.035em; max-width: 11ch; }
  .sub { margin: 0; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.5; max-width: 46ch; color: #CFCBC5; }
  .actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .more { font: 500 16px/1 var(--sans); color: var(--light); text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 7px; }
  .more:hover { color: var(--red); }

  .block { padding-top: clamp(72px, 9vw, 120px); }
  .block-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 28px; }
  h2 { font-size: clamp(32px, 3.4vw, 44px); letter-spacing: -.02em; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

  .brands { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 32px 72px; align-items: start; }
  .brands ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
  }
  .brands li { background: var(--dark); padding: 28px 20px; font: 400 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; }

  @media (max-width: 1100px) {
    .pane { inset: 0; }
    .pane::after { display: none; }
  }
  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .brands { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { height: 84vh; margin-top: -84px; }
    .pane { inset: 0; align-items: flex-end; }
    .wrap-in { padding-bottom: 48px; }
    .pane::after { display: none; }
    .grid { grid-template-columns: 1fr; }
    .brands ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
