---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ReelDialog from '../components/ReelDialog.astro';
import site from '../data/site.json';
import { nbsp } from '../lib/typo';
const icons = {
  wa: '<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1.1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>',
  tg: '<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.4 3.6 2.9 10.8c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.1.9.8.9.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.8c.3-1.3-.5-1.9-1.5-1.4zM8.6 13.5l9.9-6.2c.5-.3.9-.1.5.2l-8.4 7.6-.3 3.5-1.7-5.1z"/></svg>',
  mail: '<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 5.5h18v13H3zM3.5 6l8.5 7 8.5-7"/></svg>',
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  lang?: 'en' | 'ru';
  /** language versions of this page, e.g. { en: '/ai/', ru: '/ru/ai/' } — shows the EN/RU switch */
  alternates?: { en: string; ru: string };
  /** replaces the footer contact heading on this page */
  contactTitle?: string;
  contactText?: string;
}
const {
  title,
  description = 'Igor Sanin — creative director and filmmaker. 17 years of films that make complex things clear: exhibitions and pavilions, forum openers, brand and corporate films. Live action, CG and AI, with my own production team.',
  image = '/og.jpg',
  noindex = false,
  lang = 'en',
  alternates,
  contactTitle,
  contactText,
} = Astro.props;
const t = lang === 'ru'
  ? { work: 'Работы', reel: 'Шоурил', about: 'Обо мне', talk: 'Обсудить', location: 'Валенсия, Испания. Работаю по всему миру на русском и английском.', main: 'Основное меню' }
  : { work: 'Work', reel: 'Reel', about: 'About', talk: "Let's talk", location: site.location, main: 'Main' };
const fullTitle = title ? `${title} — Igor Sanin` : 'Igor Sanin — Creative Director & Filmmaker';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <link rel="canonical" href={new URL(path, Astro.site)} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0C0C0D" />
  {alternates && <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />}
  {alternates && <link rel="alternate" hreflang="ru" href={new URL(alternates.ru, Astro.site)} />}
</head>
<body>
  <header class="site-head">
    <div class="wrap head-in">
      <Logo size={34} />
      <nav aria-label={t.main}>
        <a href="/work/" aria-current={isActive('/work') ? 'page' : undefined}>{t.work}</a>
        {site.reelVimeo && <a href="/reel/" data-reel aria-current={isActive('/reel') ? 'page' : undefined}>{t.reel}</a>}
        <a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>{t.about}</a>
        {alternates && (
          <span class="lang" role="group" aria-label="Language">
            <a href={alternates.ru} hreflang="ru" lang="ru" aria-current={lang === 'ru' ? 'true' : undefined}>RU</a>
            <a href={alternates.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          </span>
        )}
        <a class="pill pill-red talk" href="#contact">{t.talk}</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-foot wrap">
    <section id="contact" class="contact bg-glass" style="background-image:url(/brand/glass_01_corner.webp)">
      <div class:list={["contact-lead", { custom: !!contactTitle }]}>
        <h2 class="display">{nbsp(contactTitle ?? site.footerLead)}</h2>
        {contactText && <p>{contactText}</p>}
      </div>
      <div class="contact-links">
        <div class="cta">
          {site.whatsapp && <a class="pill pill-ghost" href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} rel="noopener"><Fragment set:html={icons.wa} />WhatsApp</a>}
          {site.telegram && <a class="pill pill-ghost" href={`https://t.me/${site.telegram.replace(/^@/, '')}`} rel="noopener"><Fragment set:html={icons.tg} />Telegram</a>}
          <a class="pill pill-light" href={`mailto:${site.email}`}><Fragment set:html={icons.mail} />{site.email}</a>
        </div>
      </div>
    </section>
    <p class="foot-meta"><span>© {new Date().getFullYear()} Igor Sanin</span><span>{nbsp(t.location)}</span></p>
  </footer>

  {site.reelVimeo && <ReelDialog vimeo={site.reelVimeo} />}

  <style>
    .site-head { position: absolute; top: 0; left: 0; right: 0; z-index: 5; }
    .head-in { display: flex; align-items: center; justify-content: space-between; height: 108px; }
    main { padding-top: 108px; }
    nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 36px); }
    nav a { text-decoration: none; font-weight: 500; font-size: 16px; color: var(--light); transition: color .15s; }
    nav a:hover, nav a[aria-current] { color: var(--red); }
    nav a.talk, nav a.talk:hover { color: var(--light); height: 44px; padding: 0 22px; }
    nav a.talk:hover { color: var(--dark); }

    .site-foot { margin-top: clamp(96px, 12vw, 160px); padding-bottom: 32px; }
    .contact {
      border-radius: 20px; overflow: hidden; min-height: 320px;
      padding: clamp(32px, 5vw, 56px);
      display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px 40px;
    }
    .contact-lead { display: flex; flex-direction: column; gap: 18px; max-width: 640px; }
    .contact h2 { font-size: clamp(36px, 5vw, 64px); line-height: .95; letter-spacing: -.03em; max-width: 12ch; }
    .contact-lead.custom h2 { font-size: clamp(32px, 3.6vw, 52px); max-width: 17ch; text-wrap: balance; }
    .contact-lead p { margin: 0; font-size: 18px; line-height: 1.5; color: #E4E0DA; max-width: 44ch; }
    .lang { display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(244,242,239,.35); }
    nav .lang a { font: 400 12px/1 var(--mono); letter-spacing: .06em; padding: 8px 10px; border-radius: 999px; color: var(--light); }
    nav .lang a[aria-current] { background: var(--light); color: var(--dark); }
    nav .lang a:not([aria-current]):hover { color: var(--red); }
    .contact-links { display: flex; flex-direction: column; gap: 14px; align-items: flex-end; }
    .contact :global(.ic) { width: 18px; height: 18px; flex: none; margin-left: -4px; }
    .cta { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .pill-ghost { background: rgba(12,12,13,.35); color: var(--light); box-shadow: inset 0 0 0 1px rgba(244,242,239,.6); }
    .pill-ghost:hover { background: var(--light); color: var(--dark); }
    .links { margin: 0; display: flex; gap: 20px; font: 400 13px var(--mono); text-transform: uppercase; letter-spacing: .06em; }
    .links a { text-decoration: none; color: var(--light); }
    .links a:hover { color: var(--dark); }
    .foot-meta {
      display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
      margin: 24px 0 0; font: 400 12px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--dim);
    }
    @media (max-width: 760px) {
      .head-in { height: 84px; }
      main { padding-top: 84px; }
      nav > a:not(.talk) { display: none; }
      .contact { grid-template-columns: 1fr; }
      .contact-links { align-items: flex-start; }
      .cta { justify-content: flex-start; }
    }
  </style>
</body>
</html>
