---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ReelDialog from '../components/ReelDialog.astro';
import site from '../data/site.json';
import { nbsp } from '../lib/typo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Igor Sanin — creative director and filmmaker. 17 years of films that make complex things clear: exhibitions and pavilions, forum openers, brand and corporate films. Live action, CG and AI, with my own production team.',
  image = '/og.jpg',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} — Igor Sanin` : 'Igor Sanin — Creative Director & Filmmaker';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <link rel="canonical" href={new URL(path, Astro.site)} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0C0C0D" />
</head>
<body>
  <header class="site-head">
    <div class="wrap head-in">
      <Logo size={34} />
      <nav aria-label="Main">
        <a href="/work" aria-current={isActive('/work') ? 'page' : undefined}>Work</a>
        {site.reelVimeo && <a href="/reel" data-reel aria-current={isActive('/reel') ? 'page' : undefined}>Reel</a>}
        <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
        <a class="pill pill-red talk" href="#contact">Let's talk</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-foot wrap">
    <section id="contact" class="contact bg-glass" style="background-image:url(/brand/glass_01_corner.webp)">
      <h2 class="display">{nbsp(site.footerLead)}</h2>
      <div class="contact-links">
        <div class="cta">
          {site.whatsapp && <a class="pill pill-ghost" href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} rel="noopener">WhatsApp</a>}
          {site.telegram && <a class="pill pill-ghost" href={`https://t.me/${site.telegram.replace(/^@/, '')}`} rel="noopener">Telegram</a>}
          <a class="pill pill-light" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <p class="links">
          {site.linkedin && <a href={site.linkedin} rel="me">LinkedIn</a>}
          {site.vimeo && <a href={site.vimeo} rel="me">Vimeo</a>}
          {site.aiSite && <a href={site.aiSite}>{site.aiLabel || 'iigor.pro'}</a>}
        </p>
      </div>
    </section>
    <p class="foot-meta"><span>© {new Date().getFullYear()} Igor Sanin</span><span>{nbsp(site.location)}</span></p>
  </footer>

  {site.reelVimeo && <ReelDialog vimeo={site.reelVimeo} />}

  <style>
    .site-head { position: absolute; top: 0; left: 0; right: 0; z-index: 5; }
    .head-in { display: flex; align-items: center; justify-content: space-between; height: 108px; }
    main { padding-top: 108px; }
    nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 36px); }
    nav a { text-decoration: none; font-weight: 500; font-size: 16px; color: var(--light); transition: color .15s; }
    nav a:hover, nav a[aria-current] { color: var(--red); }
    nav a.talk, nav a.talk:hover { color: var(--light); height: 44px; padding: 0 22px; }
    nav a.talk:hover { color: var(--dark); }

    .site-foot { margin-top: clamp(96px, 12vw, 160px); padding-bottom: 32px; }
    .contact {
      border-radius: 20px; overflow: hidden; min-height: 320px;
      padding: clamp(32px, 5vw, 56px);
      display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap;
    }
    .contact h2 { font-size: clamp(36px, 5vw, 64px); line-height: .95; letter-spacing: -.03em; max-width: 12ch; }
    .contact-links { display: flex; flex-direction: column; gap: 14px; align-items: flex-end; }
    .cta { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .pill-ghost { background: rgba(12,12,13,.35); color: var(--light); box-shadow: inset 0 0 0 1px rgba(244,242,239,.6); }
    .pill-ghost:hover { background: var(--light); color: var(--dark); }
    .links { margin: 0; display: flex; gap: 20px; font: 400 13px var(--mono); text-transform: uppercase; letter-spacing: .06em; }
    .links a { text-decoration: none; color: var(--light); }
    .links a:hover { color: var(--dark); }
    .foot-meta {
      display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
      margin: 24px 0 0; font: 400 12px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--dim);
    }
    @media (max-width: 760px) {
      .head-in { height: 84px; }
      main { padding-top: 84px; }
      nav a:not(.talk) { display: none; }
      .contact-links { align-items: flex-start; }
      .cta { justify-content: flex-start; }
    }
  </style>
</body>
</html>
