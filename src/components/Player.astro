---
import sizes from '../data/video-sizes.json';
interface Props { vimeo?: string; youtube?: string; legacy?: string; title: string }
const { vimeo, youtube, legacy, title } = Astro.props;
const src = vimeo
  ? `https://player.vimeo.com/video/${vimeo}?dnt=1&title=0&byline=0&portrait=0&color=E5141B`
  : youtube
  ? `https://www.youtube-nocookie.com/embed/${youtube}?rel=0`
  : legacy
  ? `https://www-ccv.adobe.io/v1/player/ccv/${legacy}/embed?bgcolor=%23000000`
  : '';
// the video's own proportions (from Vimeo at build time), 16:9 if unknown
const real = vimeo ? (sizes as Record<string, [number, number]>)[vimeo] : undefined;
const r = real ? real[0] / real[1] : 16 / 9;
const ok = r > 0.3 && r < 4;
const ratio = ok && real ? `${real[0]} / ${real[1]}` : '16 / 9';
// never taller than 85% of the screen: tall / vertical videos get narrower and centred
const style = `aspect-ratio:${ratio};max-width:calc(85vh * ${(ok ? r : 16 / 9).toFixed(4)})`;
---
{src && (
  <div class="player" style={style} data-vimeo={vimeo || undefined}>
    <iframe src={src} title={title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
  </div>
)}
<script>
  // Vimeo's oEmbed only gives a rounded small size, so once each player is ready we ask it
  // for the video's exact pixel size and fit the frame to it (no thin bars left or right).
  const fit = (box: HTMLElement, w: number, h: number) => {
    if (!(w > 0 && h > 0)) return;
    const r = w / h;
    if (r < 0.3 || r > 4) return;
    box.style.aspectRatio = `${w} / ${h}`;
    box.style.maxWidth = `calc(85vh * ${r.toFixed(4)})`;
  };
  const boxes = new Map<Window, { box: HTMLElement; w?: number; h?: number }>();
  for (const box of document.querySelectorAll<HTMLElement>('.player[data-vimeo]')) {
    const f = box.querySelector('iframe');
    if (f?.contentWindow) boxes.set(f.contentWindow, { box });
  }
  const ask = (win: Window, method: string) => win.postMessage(JSON.stringify({ method }), 'https://player.vimeo.com');
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://player.vimeo.com') return;
    const st = boxes.get(e.source as Window);
    if (!st) return;
    let d: any;
    try { d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch { return; }
    if (d?.event === 'ready') { ask(e.source as Window, 'getVideoWidth'); ask(e.source as Window, 'getVideoHeight'); }
    if (d?.method === 'getVideoWidth') st.w = d.value;
    if (d?.method === 'getVideoHeight') st.h = d.value;
    if (st.w && st.h) fit(st.box, st.w, st.h);
  });
</script>
<style>
  .player { position: relative; aspect-ratio: 16 / 9; background: #000; width: 100%; margin: 0 auto; }
  .player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
