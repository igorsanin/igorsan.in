---
// AI production landing (/ai/ and /ru/ai/). Copy lives in src/data/ai.<lang>.json, editable in /admin.
import Base from '../layouts/Base.astro';
import { nbsp } from '../lib/typo';

interface Item { title: string; for: string; does: string; bullets: string[]; gets: string; image: string }
interface Case { title: string; tab?: string; text: string; image: string; links: { label: string; href: string }[] }
interface Props { data: any; lang: 'en' | 'ru'; noindex?: boolean }
const { data, lang, noindex = true } = Astro.props;
const products: Item[] = data.products ?? [];
const cases: Case[] = data.cases ?? [];
---
<Base
  title={data.title}
  description={data.description}
  lang={lang}
  noindex={noindex}
  alternates={{ en: '/ai/', ru: '/ru/ai/' }}
  contactTitle={data.contactTitle}
  contactText={data.contactText}
>
  <section class="hero bg-glass" style="background-image:url(/brand/glass_03_seam.webp)">
    <div class="wrap hero-in">
      <div class="htext">
        <p class="eyebrow">{data.eyebrow}</p>
        <h1 class="display">{nbsp(data.headline)}</h1>
        <p class="sub">{nbsp(data.sub)}</p>
        <div class="actions">
          <a class="pill pill-red" href="#contact">{data.ctaPrimary}</a>
          <a class="more" href="#cases">{data.ctaSecondary}</a>
        </div>
      </div>
      {data.heroImage && <img class="himg" src={data.heroImage} alt="" width="1600" height="893" fetchpriority="high" />}
    </div>
  </section>

  <section class="wrap block" aria-labelledby="products">
    <div class="head">
      <h2 id="products" class="display">{data.productsTitle}</h2>
      <p class="intro">{nbsp(data.productsIntro)}</p>
    </div>
    <div class="products">
      {products.map((p) => (
        <article class="product">
          {p.image && <img class="pic" src={p.image} alt="" width="1600" height="893" loading="lazy" decoding="async" />}
          <h3 class="display">{nbsp(p.title)}</h3>
          <dl>
            <dt>{data.labelFor}</dt>
            <dd>{nbsp(p.for)}</dd>
            <dt>{data.labelDo}</dt>
            <dd>
              {p.does && <p>{nbsp(p.does)}</p>}
              {p.bullets?.length > 0 && <ul>{p.bullets.map((b) => <li>{nbsp(b)}</li>)}</ul>}
            </dd>
            <dt>{data.labelGet}</dt>
            <dd class="gets">{nbsp(p.gets)}</dd>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap block" aria-labelledby="steps">
    <div class="head">
      <h2 id="steps" class="display">{data.stepsTitle}</h2>
      {data.billing && <p class="intro billing"><span class="rec"></span>{nbsp(data.billing)}</p>}
    </div>
    <ol class="steps">
      {data.steps.map((s: { title: string; text: string }) => (
        <li>
          <h3>{nbsp(s.title)}</h3>
          <p>{nbsp(s.text)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="cases" class="wrap block" aria-labelledby="cases-h">
    <div class="head">
      <h2 id="cases-h" class="display">{data.casesTitle}</h2>
      <p class="intro">{nbsp(data.casesIntro)}</p>
    </div>
    <div class="cases" data-cases>
      <div class="tabs" role="tablist" aria-label={data.casesTitle}>
        {cases.map((c, i) => (
          <button class="tab" role="tab" id={`case-tab-${i}`} aria-controls={`case-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="tab-t">{c.tab || c.title}</span>
            <span class="bar" aria-hidden="true"><span></span></span>
          </button>
        ))}
      </div>
      <div class="stage">
        {cases.map((c, i) => (
          <div class="panel" role="tabpanel" id={`case-${i}`} aria-labelledby={`case-tab-${i}`} hidden={i !== 0}>
            {c.image && <img class="pic" src={c.image} alt="" width="1600" height="893" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />}
            <div class="ctext">
              <h3 class="display">{nbsp(c.title)}</h3>
              <p>{nbsp(c.text)}</p>
              {c.links?.length > 0 && (
                <p class="links">{c.links.map((l) => <a class="mono-link" href={l.href}>{l.label} →</a>)}</p>
              )}
            </div>
          </div>
        ))}
        <div class="arrows">
          <button class="arrow" data-prev aria-label={data.casesPrev}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
          <button class="arrow" data-next aria-label={data.casesNext}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Case tabs: auto-advance every 8 s; stops for good once the visitor picks a case.
  // Pauses on hover/focus and while the block is off screen; off with reduced motion.
  const root = document.querySelector<HTMLElement>('[data-cases]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.panel')];
    const DUR = 8000;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, auto = !reduce && tabs.length > 1, paused = false, visible = false, elapsed = 0, last = 0;

    const show = (i: number, focus = false) => {
      cur = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        const on = k === cur;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.style.setProperty('--p', '0');
      });
      panels.forEach((p, k) => (p.hidden = k !== cur));
      if (focus) tabs[cur].focus();
      elapsed = 0;
    };
    const stop = () => { auto = false; tabs.forEach((t) => t.style.setProperty('--p', '0')); root.classList.add('manual'); };

    tabs.forEach((t, i) => t.addEventListener('click', () => { stop(); show(i); }));
    root.querySelector('.tabs')!.addEventListener('keydown', (e: Event) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); stop(); show(cur + 1, true); }
      if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); stop(); show(cur - 1, true); }
    });
    root.querySelector('[data-prev]')!.addEventListener('click', () => { stop(); show(cur - 1); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { stop(); show(cur + 1); });
    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = false));
    root.addEventListener('focusin', () => (paused = true));
    root.addEventListener('focusout', () => (paused = false));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(root);

    const tick = (now: number) => {
      const dt = last ? now - last : 0; last = now;
      if (auto && visible && !paused && !document.hidden) {
        elapsed += dt;
        tabs[cur].style.setProperty('--p', String(Math.min(elapsed / DUR, 1)));
        if (elapsed >= DUR) show(cur + 1);
      }
      if (auto) requestAnimationFrame(tick);
    };
    if (auto) requestAnimationFrame(tick); else root.classList.add('manual');
  }
</script>

<style>
  /* hero: red/black fluted brand background, text on the dark side, image clear beside it */
  .hero { margin-top: -108px; padding: 108px 0 clamp(48px, 6vw, 80px); background-position: center; }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 40px clamp(32px, 4vw, 56px); align-items: center; padding-top: clamp(24px, 4vw, 56px); }
  .htext { display: flex; flex-direction: column; gap: 22px; }
  h1 { font-size: clamp(36px, 3.7vw, 54px); line-height: .98; letter-spacing: -.035em; max-width: 19ch; text-wrap: balance; }
  .sub { margin: 0; font-size: clamp(16px, 1.3vw, 18px); line-height: 1.5; max-width: 52ch; color: #DAD6D0; }
  .actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; padding-top: 4px; }
  .more { font: 500 16px/1 var(--sans); color: var(--light); text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 7px; }
  .more:hover { color: var(--red); }
  .himg { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 16px; box-shadow: 0 30px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(244,242,239,.12); }

  .block { padding-top: clamp(64px, 7vw, 96px); }
  .head { display: flex; flex-direction: column; gap: 12px; margin-bottom: clamp(24px, 3vw, 36px); }
  h2 { font-size: clamp(30px, 3vw, 40px); letter-spacing: -.02em; }
  .intro { margin: 0; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.45; color: #CFCBC5; max-width: 60ch; }

  .pic { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; background: #19191B; }

  /* products: three equal columns, same image ratio */
  .products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .product { display: flex; flex-direction: column; gap: 18px; }
  h3.display { font-size: clamp(22px, 1.9vw, 27px); line-height: 1.02; letter-spacing: -.02em; }
  dl { margin: 0; }
  dt { font: 400 11px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--dim); padding-top: 12px; border-top: 1px solid var(--line); }
  dd { margin: 6px 0 14px; font-size: 15.5px; line-height: 1.5; color: #CFCBC5; }
  dd p { margin: 0; }
  dd ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 5px; }
  dd li { position: relative; padding-left: 16px; }
  dd li::before { content: ''; position: absolute; left: 0; top: .72em; width: 7px; height: 2px; background: var(--red); }
  dd.gets { color: var(--light); font-weight: 500; margin-bottom: 0; }

  /* steps */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; counter-reset: s; }
  .steps li { border-top: 2px solid var(--red); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { margin: 0; font-weight: 900; font-size: 20px; line-height: 1.1; letter-spacing: -.01em; }
  .steps p { margin: 0; color: #CFCBC5; line-height: 1.5; font-size: 15.5px; }


  /* cases: tabs on the left, one fixed-ratio stage on the right */
  .cases { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 24px clamp(32px, 4vw, 56px); align-items: start; }
  .tabs { display: flex; flex-direction: column; }
  .tab {
    all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 12px;
    padding: 16px 0 0; font: 900 clamp(18px, 1.5vw, 21px)/1.1 var(--sans); letter-spacing: -.01em; color: #6E6B68;
    transition: color .2s;
  }
  .tab:hover { color: var(--light); }
  .tab[aria-selected='true'] { color: var(--light); }
  .tab:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; border-radius: 2px; }
  .bar { display: block; height: 2px; background: var(--line); }
  .bar span { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--red); }
  .manual .tab[aria-selected='true'] .bar span, .tab[aria-selected='true'] .bar span { min-width: 0; }
  .manual .tab[aria-selected='true'] .bar span { width: 100%; }

  .stage { position: relative; }
  .panel { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 20px 32px; align-items: start; animation: fade .45s ease; }
  .panel[hidden] { display: none; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .ctext { display: flex; flex-direction: column; gap: 12px; padding-bottom: 56px; }
  .ctext p { margin: 0; color: #CFCBC5; line-height: 1.55; font-size: 16px; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; padding-top: 4px; }
  .arrows { position: absolute; right: 0; bottom: 0; display: flex; gap: 8px; }
  .arrow { all: unset; cursor: pointer; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: var(--light); box-shadow: inset 0 0 0 1px #3A3836; transition: background .15s, color .15s; }
  .arrow:hover { background: var(--light); color: var(--dark); }
  .arrow:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  .arrow svg { width: 16px; height: 16px; }

  @media (max-width: 1180px) {
    .panel { grid-template-columns: 1fr; }
    .ctext { padding-right: 110px; padding-bottom: 0; min-height: 44px; }
  }
  @media (max-width: 1000px) {
    .hero-in { grid-template-columns: 1fr; }
    h1 { max-width: 18ch; }
    .himg { max-width: 720px; }
    .products { grid-template-columns: 1fr; gap: 48px; }
    .product { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 0 32px; align-items: start; }
    .product .pic { grid-row: 1 / span 2; }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 28px; }
    .cases { grid-template-columns: 1fr; }
    .tabs { flex-direction: row; gap: 20px; overflow-x: auto; scrollbar-width: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter); }
    .tabs::-webkit-scrollbar { display: none; }
    .tab { flex: none; padding-top: 0; font-size: 17px; }
  }
  @media (max-width: 680px) {
    .hero { margin-top: -84px; padding-top: 84px; }
    h1 { font-size: 31px; }
    .product { display: flex; }
    .steps { grid-template-columns: 1fr; }
    .ctext { padding-right: 0; }
    .arrows { position: static; justify-content: flex-end; margin-top: 16px; }
  }
</style>
