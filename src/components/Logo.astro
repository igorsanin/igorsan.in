---
// Brand v2 name logo "igor / sanin" (outlined SVG from igor-sanin-brand-v2/logo-svg/name_light.svg).
// `size` = font size the logo was drawn at; the SVG is 1.48 em tall.
import logo from '../assets/logo-name-light.svg?raw';
const { size = 28, href = '/' } = Astro.props;
---
<a class="logo" href={href} aria-label="Igor Sanin — home" style={`height:${(size * 1.48).toFixed(1)}px`} set:html={logo} />

<style>
  .logo { display: inline-block; line-height: 0; }
  .logo :global(svg) { height: 100%; width: auto; display: block; }
</style>
