---
import { render } from 'astro:content';
import Player from './Player.astro';
import { projectUrl, type Project } from '../lib/projects';
interface Props { project: Project; next?: Project; back?: boolean }
const { project, next, back = true } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const facts = [
  ['Role', d.role],
  ['Production', d.production.replace(/^Production:\s*/, '') || d.agency],
  ['Client', d.client],
  ['Format', d.formats.join(', ')],
  ['Award', d.award],
].filter(([, v]) => v);
const meta = [d.year, d.client].filter(Boolean).join(' · ');
const isVideo = (s: string) => /\.(mp4|webm)$/i.test(s);
const hasMain = d.video.vimeo || d.video.youtube || d.video.legacy;
---
<article class="proj">
  <div class="wrap">
    <header class="head">
      {back && <a class="mono-link" href="/work">← All work</a>}
      <p class="eyebrow">{meta}</p>
      <h1 class="display">{d.title}</h1>
    </header>

    <div class="media">
      {hasMain
        ? <Player vimeo={d.video.vimeo} youtube={d.video.youtube} legacy={d.video.legacy} title={d.title} />
        : d.cover && <img class="hero-img" src={d.cover} alt="" />}
    </div>

    <div class="body">
      <dl class="facts">
        {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>
      <div class="text">
        {d.summary && <p class="lead">{d.summary}</p>}
        <Content />
        {d.credits && <p class="credits">{d.credits}</p>}
      </div>
    </div>

    {d.video.more.length > 0 && (
      <div class="grid2">
        {d.video.more.map((v) => v.startsWith('yt:')
          ? <Player youtube={v.slice(3)} title={d.title} />
          : <Player vimeo={v.replace('vimeo:', '')} title={d.title} />)}
      </div>
    )}

    {d.gallery.length > 0 && (
      <div class="grid2 gallery">
        {d.gallery.map((g) =>
          isVideo(g)
            ? <video src={g} poster={g.replace(/\.(mp4|webm)$/i, '.jpg')} autoplay muted loop playsinline preload="metadata"></video>
            : <img src={g} alt="" loading="lazy" decoding="async" />
        )}
      </div>
    )}
  </div>

  {next && (
    <a class="next" href={projectUrl(next)}>
      {next.data.cover && <img src={next.data.cover} alt="" loading="lazy" />}
      <span class="next-in wrap">
        <span class="mono-label">Next project →</span>
        <span class="next-t display">{next.data.title}</span>
      </span>
    </a>
  )}
</article>

<style>
  .head { display: flex; flex-direction: column; gap: 20px; padding-top: clamp(16px, 3vw, 40px); margin-bottom: clamp(32px, 4vw, 56px); }
  .head .mono-link { color: var(--dim); }
  h1 { font-size: clamp(44px, 6.5vw, 96px); line-height: .92; letter-spacing: -.04em; max-width: 16ch; }
  .media :global(.player), .hero-img { border-radius: 16px; overflow: hidden; }
  .hero-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }

  .body { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 40px clamp(32px, 6vw, 80px); margin: clamp(48px, 6vw, 80px) 0; }
  .facts { margin: 0; display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 14px 16px; align-content: start; font-size: 15px; }
  .facts dt { font: 400 12px var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--dim); padding-top: 3px; }
  .facts dd { margin: 0; }
  .text { max-width: 720px; font-size: 18px; line-height: 1.6; color: #CFCBC5; }
  .text :global(p) { margin: 0 0 1.1em; }
  .text :global(strong) { color: var(--light); }
  .lead { font-size: clamp(21px, 2vw, 26px) !important; line-height: 1.35; font-weight: 500; color: var(--light); }
  .credits { font: 400 13px/1.7 var(--mono); color: var(--dim); white-space: pre-line; border-top: 1px solid var(--line); padding-top: 18px; margin-top: 28px; }

  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-bottom: 24px; }
  .grid2 > :global(*) { border-radius: 12px; overflow: hidden; }
  .gallery > * { width: 100%; height: auto; background: #19191B; }
  .gallery > :nth-child(3n+1) { grid-column: 1 / -1; }

  .next { position: relative; display: block; height: clamp(260px, 26vw, 360px); margin-top: clamp(72px, 9vw, 120px); overflow: hidden; color: var(--light); text-decoration: none; }
  .next img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .next::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(12,12,13,.85), rgba(12,12,13,.35)); }
  .next:hover img { transform: scale(1.03); }
  .next-in { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding-top: 40px; padding-bottom: 40px; }
  .mono-label { font: 400 13px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .next:hover .mono-label { color: var(--red); }
  .next-t { font-size: clamp(36px, 5.5vw, 72px); line-height: .95; letter-spacing: -.035em; max-width: 18ch; }

  @media (max-width: 760px) {
    .body { grid-template-columns: 1fr; }
    .grid2 { grid-template-columns: 1fr; }
  }
</style>
