---
import { render } from 'astro:content';
import Player from './Player.astro';
import Card from './Card.astro';
import { type Project } from '../lib/projects';
import { nbsp } from '../lib/typo';
import { dims, layout, normalize, posterOf } from '../lib/media';
interface Props { project: Project; related?: Project[]; back?: boolean }
const { project, related = [], back = true } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const facts = [
  ['Role', d.role],
  ['Production', d.production.replace(/^Production:\s*/, '') || d.agency],
  ['Client', d.client],
  ['Format', d.formats.join(', ')],
  ['Award', d.award],
].filter(([, v]) => v);
const meta = [d.year, d.client].filter(Boolean).join(' · ');
const hasMain = d.video.vimeo || d.video.youtube || d.video.legacy;
const rows = await layout(normalize(d.gallery));
const coverSize = !hasMain && d.cover ? await dims(d.cover) : null;
// a picture is never shown wider than its real pixel width
const cap = (w: number) => `max-width:${w}px`;
---
<article class="proj">
  <div class="wrap">
    <header class="head">
      <div class="toprow">
        <p class="eyebrow">{meta}</p>
        {back && <a class="back" href="/work/">← All work</a>}
      </div>
      <h1 class="display">{nbsp(d.title)}</h1>
    </header>

    <div class="media">
      {hasMain
        ? <Player vimeo={d.video.vimeo} youtube={d.video.youtube} legacy={d.video.legacy} title={d.title} />
        : d.cover && <img class="hero-img" src={d.cover} alt="" style={coverSize ? cap(coverSize.w) : undefined} />}
    </div>

    <div class="body">
      <dl class="facts">
        {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>
      <div class="text">
        {d.summary && <p class="lead">{nbsp(d.summary)}</p>}
        <Content />
        {d.credits && <p class="credits">{d.credits}</p>}
      </div>
    </div>

    {d.video.more.length > 0 && (
      <div class="grid2">
        {d.video.more.map((v) => v.startsWith('yt:')
          ? <Player youtube={v.slice(3)} title={d.title} />
          : <Player vimeo={v.replace('vimeo:', '')} title={d.title} />)}
      </div>
    )}

    {rows.length > 0 && (
      <div class="gallery">
        {rows.map((row) => (
          <div class="g-row">
            {row.map((g) => (
              <div class={`g-item s${g.span}`} style={cap(g.w)}>
                {g.video
                  ? <video src={g.file} poster={posterOf(g.file)} width={g.w} height={g.h} autoplay muted loop playsinline preload="metadata"></video>
                  : <img src={g.file} alt="" width={g.w} height={g.h} loading="lazy" decoding="async" />}
              </div>
            ))}
          </div>
        ))}
      </div>
    )}
  </div>

  {related.length > 0 && (
    <section class="wrap related" aria-labelledby="rel">
      <div class="rel-head">
        <h2 id="rel" class="display">Related projects</h2>
        {back && <a class="mono-link" href="/work/">All projects →</a>}
      </div>
      <div class="rel-grid">{related.map((p) => <Card project={p} />)}</div>
    </section>
  )}
</article>

<style>
  .head { display: flex; flex-direction: column; gap: 20px; padding-top: clamp(16px, 3vw, 40px); margin-bottom: clamp(32px, 4vw, 56px); }
  .toprow { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .back { font: 500 15px/1 var(--sans); color: var(--dim); text-decoration: none; }
  .back:hover { color: var(--red); }
  h1 { font-size: clamp(44px, 6.5vw, 96px); line-height: .92; letter-spacing: -.04em; max-width: 16ch; }
  .media :global(.player), .hero-img { border-radius: 16px; overflow: hidden; }
  .hero-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; margin: 0 auto; }

  .body { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 40px clamp(32px, 6vw, 80px); margin: clamp(48px, 6vw, 80px) 0; }
  .facts { margin: 0; display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 14px 16px; align-content: start; font-size: 15px; }
  .facts dt { font: 400 12px var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--dim); padding-top: 3px; }
  .facts dd { margin: 0; }
  .text { max-width: 720px; font-size: 18px; line-height: 1.6; color: #CFCBC5; }
  .text :global(p) { margin: 0 0 1.1em; }
  .text :global(strong) { color: var(--light); }
  .lead { font-size: clamp(21px, 2vw, 26px) !important; line-height: 1.35; font-weight: 500; color: var(--light); }
  .credits { font: 400 13px/1.7 var(--mono); color: var(--dim); white-space: pre-line; border-top: 1px solid var(--line); padding-top: 18px; margin-top: 28px; }

  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-bottom: 24px; }
  .grid2 > :global(*) { border-radius: 12px; overflow: hidden; }
  /* gallery: rows of up to 6 columns (full = 6, half = 3, third = 2), centred;
     each item is capped at its real pixel width so nothing is blown up */
  .gallery { --gap: 24px; display: flex; flex-direction: column; gap: var(--gap); }
  .g-row { display: flex; justify-content: center; align-items: flex-start; gap: var(--gap); }
  .g-item { flex: 0 1 auto; border-radius: 12px; overflow: hidden; background: #19191B; }
  .g-item.s6 { width: 100%; }
  .g-item.s3 { width: calc((100% - var(--gap)) / 2); }
  .g-item.s2 { width: calc((100% - 2 * var(--gap)) / 3); }
  .g-item img, .g-item video { display: block; width: 100%; height: auto; }

  .related { margin-top: clamp(80px, 10vw, 128px); }
  .rel-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 28px; }
  .rel-head h2 { font-size: clamp(28px, 3vw, 40px); letter-spacing: -.02em; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 1000px) { .rel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .rel-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .body { grid-template-columns: 1fr; }
    .grid2 { grid-template-columns: 1fr; }
    .gallery { --gap: 16px; }
    .g-row { flex-wrap: wrap; }
    .g-item.s3, .g-item.s6 { width: 100%; }
    .g-item.s2 { width: calc((100% - var(--gap)) / 2); }
  }
</style>
